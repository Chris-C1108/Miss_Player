            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>...</title>\n<style media=\"screen\">\n* {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n    box-sizing: border-box;\n}\n      body {\n        overflow: hidden;\n        /*margin: 0px;*/\n        /*background-color: rgb(2, 2, 2);*/\n        /*        background: url('undefined');*/\n        /*background-size: cover;*/\n        /*background-repeat: no-repeat;*/\n        /*min-height: 100%;*/\n              }\n      .outer {\n        display: table;\n        position: absolute;\n        height: 100%;\n        width: 100%;\n      }\n\n      .middle {\n        display: table-cell;\n        vertical-align: middle;\n      }\n\n      .inner {\n        margin-left: auto;\n        margin-right: auto;\n        width: 90px;\n        color: white;\n        text-align: center;\n        background: black;\n        background: #000000b3;\n        border-radius: 6px;\n      }\n      .footer{\n        position: absolute;\n        bottom: 3px;\n        right: 3px;\n        color: grey;\n        font-size: 7px;\n      }\n\n      .footer a{\n        text-decoration: none;\n        color: grey;\n      }\n\n      .playbutton {\n        width: fit-content;\n        border-radius: 3px;\n        margin: 0 auto;\n        cursor: pointer;\n      }\n      .playbutton span {\n        font-size: 50px;\n        top: 50%;\n        left: 50%;\n        transform: translate3d(-50%,-50%,0);\n        position: absolute;\n        width: 90px;\n        height: 60px;\n        background-color: #333;\n        box-shadow: 0 0 30px rgba(0,0,0,.6);\n           border-radius: 6px;\n      }\n      .playbutton span:before {\n          content: \"\";\n          border-style: solid;\n         border-width: 15px 0 15px 26px;\n          border-color: transparent transparent transparent #fff;\n          position: absolute;\n          top: 50%;\n           left: 50%;\n          transform: translate3d(-50%,-50%,0);\n}\n\n      @-moz-document url-prefix() {\n  .playbutton span {\n    font-size: 42px;\n  }\n}\n\niframe {\n    display: block; /* iframes are inline by default */\n    background: #000;\n    border: none; /* Reset default border */\n    height: 100vh; /* Viewport-relative units */\n    width: 100vw;\n}\n    </style>\n</head>\n<body>\n<div class=\"outer\">\n<div class=\"middle\">\n\n<div class=\"inner\">\n<h1></h1>\n<p><br><span id=\"loader\"></span></p>\n</div>\n</div>\n</div>\n<script type=\"text/javascript\">\nfunction show_continue() {\n    var inner=document.getElementsByClassName('inner')[0];\n    inner.innerHTML = '<div onclick=\"start_player()\" class=\"playbutton\"> <span></span></div>';\n}\n\n\nvar intv = setInterval(function() {\n    if (document.getElementById('loader').innerHTML!=\"\") {\n        document.getElementById('loader').innerHTML +=\"\";\n    } else{\n        clearInterval(intv);\n        //show_continue();\n    }\n}, 100);\nfunction start_player() {\n    var OLID = '5f493559b086e947c47bcd71e04ac5e8562fb5c897800f310dfef01ac1bdb3ddf39f67f6d4447d64091383c527e765ff0d92b2425d1d8ee110e70ba83e032f0169f9743a1b731d8dc96d10b9ba34595e';\n    OLID = OLID.split('').reverse().join('');\n    document.body.innerHTML='<iframe frameborder=\"0\" src=\"?c='+OLID+'\" allowfullscreen scrolling=\"no\" style=\"display: block; background: #000; border: none; height: 100 vh ; width: 100 vw ;\"></iframe>';\n}\nstart_player();\n//setTimeout(\"start_player()\",101);\nif (top.location.href == location.href) {\n    document.body.innerHTML='404';\n}\n\n</script>\n<script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/v4513226cdae34746b4dedf0b4dfa099e1781791509496\" integrity=\"sha512-ZE9pZaUXND66v380QUtch/5sE9tPFh2zg45pR2PB0CVkCtOREv2AJKkSidISWkysEuQ0EH8faUU5du78bx87UQ==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"d40c06ac04f7404993cc195be99f275c\",\"r\":1}' crossorigin=\"anonymous\"></script>\n</body>\n</html>\n"

          ],
          "cookies": [],
          "content": {
            "size": 8556,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n  <meta charset=\"utf-8\"/>\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=11\" />\n  <meta content=\"width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no\" id=\"viewport\" name=\"viewport\">\n  <meta name=\"x5-video-player-type\" content=\"h5-page\">\n  <meta name=\"x5-video-orientation\" content=\"portrait\">\n  <meta name=\"x5-playsinline\" content=\"true\">\n  <title>影片播放器</title>\n\n  <link rel=\"stylesheet\" href=\"https://jav.sb/videojs/video-js.css\">\n  <script src=\"https://jav.sb/videojs/video.min.js\"></script>\n  <link rel=\"stylesheet\" href=\"https://jav.sb/videojs/videojs-logo.css\">\n  <script src=\"https://jav.sb/videojs/videojs-logo.min.js\"></script>\n\n  <style>\n    html, body { width: 100%; height: 100%; margin: 0; padding: 0; background: #000; overflow: hidden; }\n    #playerHost { width: 100%; height: 100%; min-height: 200px; }\n\n    /* 覆蓋層 */\n    #promo-layer {\n      position: fixed; inset: 0; background: #000; color: #fff;\n      display: flex; justify-content: center; align-items: center; z-index: 9999;\n    }\n    #promo-box a.promo-full { position: fixed; inset: 0; display: block; z-index: 9999; }\n    #promo-box a.promo-full img {\n      width: 100vw; height: 100dvh; object-fit: cover; display: block;\n      -webkit-user-drag: none; user-select: none;\n    }\n\n    #promo-start {\n      position: fixed;\n      top: calc(14px + env(safe-area-inset-top));\n      right: calc(8px + env(safe-area-inset-right));\n      background: #e11; color: #fff;\n      padding: 10px 12px; border-radius: 4px;\n      z-index: 10001; user-select: none; border: none;\n      font-size: 14px; line-height: 1; cursor: pointer;\n      box-shadow: 0 6px 18px rgba(0,0,0,.35);\n    }\n\n    /* --- 進度條優化：橫跨頂部防止手機端擠壓 --- */\n    .video-js .vjs-control-bar {\n      display: flex;\n      height: 50px;\n      background: rgba(0,0,0,0.7);\n    }\n    \n    /* 強制進度條置頂並全寬 */\n    .video-js .vjs-progress-control {\n      position: absolute !important;\n      width: 100% !important;\n      height: 14px !important;\n      top: -14px !important;\n      left: 0;\n    }\n    .video-js .vjs-progress-holder {\n      height: 4px !important;\n      margin: 0 !important;\n    }\n\n    /* 自訂按鈕樣式 (快進、快退、倍速) */\n    .vjs-text-control {\n      cursor: pointer;\n      font-family: Arial, sans-serif;\n      font-weight: bold;\n      display: flex !important;\n      align-items: center;\n      justify-content: center;\n      min-width: 48px;\n      font-size: 13px !important;\n      color: #fff;\n      z-index: 10;\n    }\n    .vjs-text-control:active { color: #ff0; }\n\n    /* 手機端自動隱藏較不重要的元件以騰出空間 */\n    @media (max-width: 480px) {\n       .vjs-current-time-display, .vjs-time-divider {\n        display: none !important;\n      }\n    }\n\n    /* 隱藏原生不需要的按鈕 */\n    .vjs-picture-in-picture-control, .vjs-subs-caps-button { display: none !important; }\n  </style>\n</head>\n<body>\n  <div id=\"promo-layer\" role=\"dialog\" aria-modal=\"true\" aria-label=\"合作展示\">\n    <div id=\"promo-box\"></div>\n    <button id=\"promo-start\" type=\"button\" aria-label=\"播放影片\">播放影片</button>\n  </div>\n\n  <div id=\"playerHost\" role=\"region\" aria-label=\"影片播放器\"></div>\n\n  <script>\n  (function () {\n    const OUT = \"https://jav.sb/videojs/out.php\";\n    const outWithTs = () => OUT + \"?_=\" + Date.now();\n\n    // 開窗邏輯\n    function openPartnerWindow() {\n      const url = outWithTs();\n      try {\n        const a = document.createElement('a');\n        a.href = url; a.target = '_blank'; a.rel = 'noopener';\n        document.body.appendChild(a); a.click(); document.body.removeChild(a);\n      } catch(e) { window.open(url, '_blank'); }\n    }\n\n    function getPosterUrl() {\n      const mp = (window.parent && window.parent.MacPlayer) || null;\n      let url = mp && mp.Poster ? mp.Poster : \"\";\n      if (!url) {\n        try { const qs = new URLSearchParams(location.search); url = qs.get(\"pic\") || \"\"; } catch(e){}\n      }\n      if (!url) return \"https://jav.sb/videojs/bk.png\";\n      if (!/^https?:\\/\\//i.test(url)) url = \"https://jav.sb/\" + url.replace(/^\\/+/, \"\");\n      return url;\n    }\n\n    const img = new Image();\n    img.src = getPosterUrl();\n    img.onerror = function(){ this.src = \"https://jav.sb/videojs/bk.png\"; };\n    const cover = document.createElement(\"a\");\n    cover.href = outWithTs(); cover.target = \"_blank\"; cover.className = \"promo-full\";\n    cover.appendChild(img);\n    document.getElementById(\"promo-box\").appendChild(cover);\n\n    function getSrc() {\n      const mp = (window.parent && window.parent.MacPlayer) || null;\n      let src = mp && mp.PlayUrl ? mp.PlayUrl : \"\";\n      if (!src) { try{ const qs=new URLSearchParams(location.search); src = qs.get(\"src\") || \"\"; }catch(e){} }\n      return src;\n    }\n\n    function guessMime(u) {\n      if (/m3u8/i.test(u)) return \"application/x-mpegURL\";\n      return \"video/mp4\";\n    }\n\n    function getToken(file) {\n      return fetch(`/token.php?file=${file}`, { cache: \"no-store\" }).then(res => res.json());\n    }\n\n    function getRealUrlFromCache(file, token, ts, key) {\n      return fetch(`/save_m3u8_cache.php?file=${file}&token=${token}&ts=${ts}&sign=${key}`, { cache: \"no-store\" }).then(res => res.json());\n    }\n\n    let playerurl = getSrc();\n    let ky_ = playerurl + '@' + Math.floor(Date.now() / 1000);\n    let key = (window.parent && window.parent.encrypt) ? window.parent.encrypt(ky_) : ky_;\n\n    getToken(playerurl).then(({token, ts}) => {\n      getRealUrlFromCache(playerurl, token, ts, key).then(data => {\n        const finalSrc = data.m3u8_file + '&sign=' + key;\n        initPlayer(finalSrc);\n      }).catch(e => console.error(\"M3U8 Fail\", e));\n    }).catch(e => console.error(\"Token Fail\", e));\n\n    function initPlayer(src) {\n      let started = false;\n      document.getElementById(\"promo-start\").addEventListener(\"click\", function () {\n        document.getElementById(\"promo-layer\").style.display = \"none\";\n        if (started) return;\n        started = true;\n\n        const v = document.createElement(\"video\");\n        v.id = \"playerCnt\";\n        v.className = \"video-js vjs-default-skin vjs-big-play-centered\";\n        v.setAttribute(\"playsinline\",\"\"); v.setAttribute(\"webkit-playsinline\",\"\"); v.setAttribute(\"x5-playsinline\",\"true\");\n        document.getElementById(\"playerHost\").appendChild(v);\n\n        const player = videojs(\"playerCnt\", {\n          controls: true,\n          autoplay: true,\n          preload: \"auto\",\n          fluid: true,\n          playbackRates: [], // 禁用原生選單\n          sources: [{ src: src, type: guessMime(src) }]\n        }, function () {\n          const bar = this.getChild(\"controlBar\");\n\n          // 1. 添加快退 10s\n          addTextBtn(this, \"⟲ 10s\", () => this.currentTime(this.currentTime() - 10), 1);\n          \n          // 2. 添加快進 10s\n          addTextBtn(this, \"10s ⟳\", () => this.currentTime(this.currentTime() + 10), 3);\n\n          // 3. 添加倍速切換 (點擊循環)\n          addSpeedBtn(this, 4);\n\n          try{ this.logo({ image: 'https://jav.sb/MDassets/img/JAVSB_58x16.png' }); }catch(e){}\n        });\n\n        player.play();\n        openPartnerWindow();\n      });\n    }\n\n    // 通用文字按鈕組件\n    function addTextBtn(player, label, action, index) {\n      const Button = videojs.getComponent(\"Button\");\n      const btn = new Button(player);\n      btn.el().classList.add(\"vjs-control\", \"vjs-button\", \"vjs-text-control\");\n      btn.el().innerHTML = label;\n      btn.on(\"click\", (e) => { e.preventDefault(); action(); });\n      btn.on(\"touchstart\", (e) => { e.preventDefault(); action(); });\n      player.getChild(\"controlBar\").addChild(btn, {}, index);\n    }\n\n    // 倍速切換按鈕組件\n    function addSpeedBtn(player, index) {\n      const rates = [1.0, 1.25, 1.5, 2.0, 0.5];\n      let currentIdx = 0;\n      const Button = videojs.getComponent(\"Button\");\n      const btn = new Button(player);\n      \n      btn.el().classList.add(\"vjs-control\", \"vjs-button\", \"vjs-text-control\");\n      btn.el().innerHTML = \"1.0x\";\n      \n      const nextRate = (e) => {\n        e.preventDefault();\n        currentIdx = (currentIdx + 1) % rates.length;\n        const newRate = rates[currentIdx];\n        player.playbackRate(newRate);\n        btn.el().innerHTML = newRate + \"x\";\n      };\n\n      btn.on(\"click\", nextRate);\n      btn.on(\"touchstart\", nextRate);\n      player.getChild(\"controlBar\").addChild(btn, {}, index);\n    }\n\n  })();\n  </script>\n</body>\n</html>"
          },

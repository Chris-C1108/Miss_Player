   = document.querySelectorAll('#tab-panels [data-tab-panel]');\n    var shotsLoaded = false;\n\n    function loadShotsOnce() {\n      if (shotsLoaded) return;\n      var box = document.querySelector('[data-tab-panel=\"thumbnail\"]');\n      if (!box) return;\n\n      var imgs = box.querySelectorAll('img.js-shot-lazy[data-src]');\n      imgs.forEach(function (img) {\n        var real = img.getAttribute('data-src');\n        if (real) {\n          img.src = real;\n          img.removeAttribute('data-src');\n        }\n      });\n\n      shotsLoaded = true;\n    }\n\n    function showTab(tabName) {\n      // Tab 樣式切換\n      tabLinks.forEach(function (el) {\n        var active = el.getAttribute('data-tab') === tabName;\n\n        el.classList.toggle('border-red-400', active);\n        el.classList.toggle('text-red-400', active);\n        el.classList.toggle('border-transparent', !active);\n        el.classList.toggle('text-gray-500', !active);\n      });\n\n      // 面板切換\n      tabPanels.forEach(function (panel) {\n        var active = panel.getAttribute('data-tab-panel') === tabName;\n        if (active) {\n          panel.classList.remove('hidden');\n        } else {\n          panel.classList.add('hidden');\n        }\n      });\n\n      // 切換至截圖分頁時加載圖片\n      if (tabName === 'thumbnail') {\n        loadShotsOnce();\n      }\n    }\n\n    // 點擊事件\n    tabLinks.forEach(function (el) {\n      el.addEventListener('click', function (e) {\n        e.preventDefault();\n        var tabName = el.getAttribute('data-tab');\n        if (tabName) {\n          showTab(tabName);\n        }\n      });\n    });\n\n    // 預設顯示詳細資訊\n    showTab('intro');\n  });\n  </script>\n</body>\n</html>"

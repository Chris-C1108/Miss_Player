              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=7Kl7ei9G64wVpJslCmXpXWBQqKr493i0%2FiN5BU8BT9YtBMFK8n%2Fc5ZW0eRSefW%2ByYtDwtGz85SZcF3WHVI%2B2zPdiR7PguHGbXWl26wP07SMCqEmkPqCTUg%3D%3D\"}]}"

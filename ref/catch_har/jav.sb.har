            "size": 805,
            "mimeType": "text/css",
            "text": "/* 截圖 Lightbox 樣式 */\r\n.shot-lightbox {\r\n    position: fixed;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: 0;\r\n    background: rgba(0,0,0,0.8);\r\n    display: none;\r\n    align-items: center;\r\n    justify-content: center;\r\n    z-index: 2147483647 !important;\r\n}\r\n\r\n.shot-lightbox-inner {\r\n    position: relative;\r\n    max-width: 95%;\r\n    max-height: 95%;\r\n}\r\n\r\n.shot-lightbox-inner img {\r\n    max-width: 100%;\r\n    max-height: 100%;\r\n    border-radius: 4px;\r\n}\r\n\r\n.shot-lightbox-close {\r\n    position: absolute;\r\n    top: -10px;\r\n    right: -10px;\r\n    background: #fff;\r\n    color: #000;\r\n    border-radius: 50%;\r\n    width: 28px;\r\n    height: 28px;\r\n    line-height: 28px;\r\n    text-align: center;\r\n    cursor: pointer;\r\n    font-size: 18px;\r\n}\r\n\r\n.shot-thumb {\r\n    display: block;\r\n}\r\n"
